# Domínio que aponta para a VPS. Sem domínio, use o IP com sslip.io, ex.: 203.0.113.10.sslip.io
DOMINIO=203.0.113.10.sslip.io
# Endereço que vai no QR code do telão
PUBLIC_URL=https://203.0.113.10.sslip.io
# Senha dos controles do telão (#/telao?admin). Troque!
ADMIN_TOKEN=troque-esta-senha
# Segundos entre blocos
BLOCK_INTERVAL_SECONDS=20
# Zeros exigidos no começo do hash e velocidade da mineração (hashes por segundo)
DIFFICULTY=4
HASHES_PER_SECOND=25000
FAUCET=100
BLOCK_REWARD=10
